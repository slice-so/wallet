  "files": [
    "./dist",
    "./LICENSE-MIT",
    "./LICENSE-APACHE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun --conditions=development test",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --write && bun scripts/check-import-boundaries.ts",
    "check": "biome check --write --unsafe && bun scripts/check-import-boundaries.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slicekit/abi": "0.0.24",
    "@slicekit/erc8128": "0.4.0",
