{
  "name": "@slicekit/wallet",
  "version": "0.1.2",
  "description": "Low-level Slice Wallet runtime for Kernel v4 passkey accounts, isolated signing ceremonies, policy-scoped execution, provider integration, and recovery",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./protocol": {
      "development": {
        "types": "./src/protocol/index.ts",
        "import": "./src/protocol/index.ts",
        "default": "./src/protocol/index.ts"
      },
      "types": "./dist/esm/protocol/index.d.ts",
      "import": "./dist/esm/protocol/index.js",
      "default": "./dist/esm/protocol/index.js"
    },
    "./assets": {
      "development": {
        "types": "./src/assets.ts",
        "import": "./src/assets.ts",
        "default": "./src/assets.ts"
      },
      "types": "./dist/esm/assets.d.ts",
      "import": "./dist/esm/assets.js",
      "default": "./dist/esm/assets.js"
    },
    "./execution": {
      "development": {
        "types": "./src/execution.ts",
        "import": "./src/execution.ts",
        "default": "./src/execution.ts"
      },
      "types": "./dist/esm/execution.d.ts",
      "import": "./dist/esm/execution.js",
      "default": "./dist/esm/execution.js"
    },
    "./kernel": {
      "development": {
        "types": "./src/protocol/kernel.ts",
        "import": "./src/protocol/kernel.ts",
        "default": "./src/protocol/kernel.ts"
      },
      "types": "./dist/esm/protocol/kernel.d.ts",
      "import": "./dist/esm/protocol/kernel.js",
      "default": "./dist/esm/protocol/kernel.js"
    },
    "./policy": {
      "development": {
        "types": "./src/protocol/policy.ts",
        "import": "./src/protocol/policy.ts",
        "default": "./src/protocol/policy.ts"
      },
      "types": "./dist/esm/protocol/policy.d.ts",
      "import": "./dist/esm/protocol/policy.js",
      "default": "./dist/esm/protocol/policy.js"
    },
    "./argon2id": {
      "development": {
        "types": "./src/argon2id.ts",
        "import": "./src/argon2id.ts",
        "default": "./src/argon2id.ts"
      },
      "types": "./dist/esm/argon2id.d.ts",
      "import": "./dist/esm/argon2id.js",
      "default": "./dist/esm/argon2id.js"
    },
    "./ceremony-routes": {
      "development": {
        "types": "./src/ceremonyRoutes.ts",
        "import": "./src/ceremonyRoutes.ts",
        "default": "./src/ceremonyRoutes.ts"
      },
      "types": "./dist/esm/ceremonyRoutes.d.ts",
      "import": "./dist/esm/ceremonyRoutes.js",
      "default": "./dist/esm/ceremonyRoutes.js"
    },
    "./frame": {
      "development": {
        "types": "./src/frame.ts",
        "import": "./src/frame.ts",
        "default": "./src/frame.ts"
      },
      "types": "./dist/esm/frame.d.ts",
      "import": "./dist/esm/frame.js",
      "default": "./dist/esm/frame.js"
    },
    "./permissions": {
      "development": {
        "types": "./src/permissions.ts",
        "import": "./src/permissions.ts",
        "default": "./src/permissions.ts"
      },
      "types": "./dist/esm/permissions.d.ts",
      "import": "./dist/esm/permissions.js",
      "default": "./dist/esm/permissions.js"
    },
    "./recovery": {
      "development": {
        "types": "./src/recovery.ts",
        "import": "./src/recovery.ts",
        "default": "./src/recovery.ts"
      },
      "types": "./dist/esm/recovery.d.ts",
      "import": "./dist/esm/recovery.js",
      "default": "./dist/esm/recovery.js"
    },
    "./provider": {
      "development": {
        "types": "./src/provider.ts",
        "import": "./src/provider.ts",
        "default": "./src/provider.ts"
      },
      "types": "./dist/esm/provider.d.ts",
      "import": "./dist/esm/provider.js",
      "default": "./dist/esm/provider.js"
    },
    "./server": {
      "development": {
        "types": "./src/server.ts",
        "import": "./src/server.ts",
        "default": "./src/server.ts"
      },
      "types": "./dist/esm/server.d.ts",
      "import": "./dist/esm/server.js",
      "default": "./dist/esm/server.js"
    }
  },
  "files": [
    "./dist",
    "./LICENSE-MIT",
    "./LICENSE-APACHE"
  ],
  "scripts": {
    "build": "bun run generate:chains:check && bun run build.ts",
    "generate:chains": "bun scripts/generate-chains.ts",
    "generate:chains:check": "bun scripts/generate-chains.ts --check",
    "test": "bun --conditions=development test",
    "type-check": "bun run generate:chains:check && tsc -p tsconfig.json --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --write && bun scripts/check-import-boundaries.ts",
    "check": "biome check --write --unsafe && bun scripts/check-import-boundaries.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slicekit/abi": "0.1.0",
    "hash-wasm": "4.12.0",
    "ox": "^0.14.36",
    "tslib": "^2.8.1",
    "viem": "^2.48.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "6.0.2",
    "@types/node": "~26.2.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "7.0.2",
    "bun-types": "1.4.0",
    "@biomejs/biome": "^2.5.10",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slice-so/wallet"
  }
}
