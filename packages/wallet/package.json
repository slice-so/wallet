    "@zerodev/sdk": "5.5.10",
    "hash-wasm": "4.12.0",
    "ox": "^0.14.29",
    "tslib": "^2.8.1",
    "viem": "^2.48.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.100.11",
    "@wagmi/core": "^3.4.3",
    "react": ">=18",
    "wagmi": "^3.6.11"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "~25.6.2",
    "@types/react": "~19.2.14",
    "@wagmi/core": "^3.4.3",
    "fake-indexeddb": "^6.2.4",
    "wagmi": "^3.6.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slice-so/wallet"
  }
