  "scripts": {
    "admit:canary": "bun --conditions=development scripts/create-user-operation-canary.ts",
    "build": "bun run generate:chains:check && bun run generate:commerce:check && bun run build.ts",
    "generate:chains": "bun scripts/generate-chains.ts",
    "generate:chains:check": "bun scripts/generate-chains.ts --check",
    "generate:commerce": "bun --conditions=development scripts/generate-commerce-facts.ts",
    "generate:commerce:check": "bun --conditions=development scripts/generate-commerce-facts.ts --check",
    "test": "bun --conditions=development test",
    "test:e2e:two-chain": "bash ./scripts/run-wallet-two-chain-e2e.sh",
    "verify:chains": "bun scripts/verify-chain-deployments.ts",
    "type-check": "bun run generate:chains:check && bun run generate:commerce:check && tsc -p tsconfig.json --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --write && bun scripts/check-import-boundaries.ts",
    "check": "biome check --write --unsafe && bun scripts/check-import-boundaries.ts"
  },
  "publishConfig": {
