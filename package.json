{
  "name": "slice-wallet-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/wallet"
  ],
  "scripts": {
    "build": "bun run --cwd packages/wallet build",
    "check": "bun run --cwd packages/wallet check",
    "test": "bun run build && bun run --cwd packages/wallet test",
    "type-check": "bun run build && bun run --cwd packages/wallet type-check",
    "contracts:build": "forge build --root packages/contracts",
    "contracts:install": "cd packages/contracts && forge soldeer install",
    "contracts:test": "forge test --root packages/contracts"
  }
}
