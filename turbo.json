{
  "extends": ["//"],
  "tasks": {
    "admit:canary": {
      "cache": false,
      "env": [
        "PRIVATE_KEY",
        "RPC_URL_ARBITRUM",
        "RPC_URL_BASE",
        "RPC_URL_ETHEREUM",
        "RPC_URL_OP"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "envMode": "loose",
      "inputs": [
        "src/**/*.ts",
        "build.ts",
        "config/chains.policy.json",
        "scripts/generate-chains.ts",
        "../contracts/wallet/deployments/addresses.json"
      ],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "src/**/*.ts",
        "config/chains.policy.json",
        "scripts/generate-chains.ts",
        "../contracts/wallet/deployments/addresses.json"
      ]
    },
    "test": {
      "dependsOn": ["test:e2e:two-chain"]
    },
    "test:e2e:two-chain": {
      "cache": false,
      "dependsOn": ["@slice/contracts#build:wallet"],
      "env": [
        "RPC_URL_BASE",
        "WALLET_E2E_BUNDLER_PORT_A",
        "WALLET_E2E_BUNDLER_PORT_B",
        "WALLET_E2E_RPC_PORT_A",
        "WALLET_E2E_RPC_PORT_B"
      ],
      "inputs": ["$TURBO_DEFAULT$", "../../scripts/run-wallet-two-chain-e2e.sh"]
    }
  }
}
