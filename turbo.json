{
  "extends": ["//"],
  "tasks": {
    "admit:canary": {
      "cache": false,
      "env": [
        "PRIVATE_KEY",
        "RPC_URL_ARBITRUM",
        "RPC_URL_BASE",
        "RPC_URL_ETHEREUM",
        "RPC_URL_OP"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "envMode": "loose",
      "inputs": [
        "src/**/*.ts",
        "build.ts",
        "config/chains.policy.json",
        "scripts/generate-chains.ts",
        "../contracts/core/deployments/addresses.json"
      ],
      "outputs": ["dist/**"]
    }
  }
}
